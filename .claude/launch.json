{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/serve.py",
        "8795"
      ],
      "port": 8795
    },
    {
      "name": "streamlit",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": [
        "run",
        "streamlit_app.py",
        "--server.port",
        "8502",
        "--server.headless",
        "true"
      ],
      "port": 8502
    }
  ]
}